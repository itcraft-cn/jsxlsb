    "@types/node": "^20.11.0",
    "@types/pako": "^2.0.4",
    "rollup": "^4.9.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "repository": {
